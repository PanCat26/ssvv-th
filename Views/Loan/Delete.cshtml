@model ssvv_th.Models.Loan
@{
    ViewData["Title"] = "Delete Loan";
}

<h1 class="h3 mb-3">Delete Loan</h1>

<div class="alert alert-warning">Are you sure you want to delete this loan?</div>

<dl class="row">
    <dt class="col-sm-3">Book</dt>
    <dd class="col-sm-9">@Model.Book?.Title</dd>
    <dt class="col-sm-3">Member</dt>
    <dd class="col-sm-9">@Model.Member?.Name</dd>
    <dt class="col-sm-3">Loan Date</dt>
    <dd class="col-sm-9">@Model.LoanDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Due Date</dt>
    <dd class="col-sm-9">@Model.DueDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Return Date</dt>
    <dd class="col-sm-9">@(Model.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
