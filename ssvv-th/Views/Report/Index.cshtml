@model ssvv_th.Models.LoanReportViewModel
@using ssvv_th.Models
@{
    ViewData["Title"] = "Reports";

    string periodLabel = (Model.FromDate, Model.ToDate) switch
    {
        ({ } fromDate, { } toDate) => $"{fromDate:yyyy-MM-dd} to {toDate:yyyy-MM-dd}",
        ({ } fromDate, null) => $"from {fromDate:yyyy-MM-dd}",
        (null, { } toDate) => $"until {toDate:yyyy-MM-dd}",
        _ => "all time"
    };

    string BadgeClass(string status) => status switch
    {
        "Returned" => "bg-secondary",
        "Overdue" => "bg-danger",
        _ => "bg-success"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Loan Reports</h1>
        <div class="text-muted">Books loaned during @periodLabel</div>
    </div>
    <a class="btn btn-outline-primary"
       asp-action="ExportCsv"
       asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
       asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
       asp-route-reportType="@Model.ReportType"
       asp-route-searchTerm="@Model.SearchTerm">Export CSV</a>
</div>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label asp-for="FromDate" class="form-label"></label>
        <input asp-for="FromDate" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="ToDate" class="form-label"></label>
        <input asp-for="ToDate" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="ReportType" class="form-label"></label>
        <select asp-for="ReportType" asp-items="Html.GetEnumSelectList<LoanReportType>()" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="SearchTerm" class="form-label"></label>
        <input asp-for="SearchTerm" class="form-control" placeholder="Book, author, member, or email" />
    </div>
    <div class="col-md-3 d-grid gap-2">
        <button type="submit" class="btn btn-primary">View Report</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="border rounded p-3">
            <div class="text-muted small">Books Loaned</div>
            <div class="fs-4 fw-semibold">@Model.TotalBooksLoaned</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="border rounded p-3">
            <div class="text-muted small">Unique Books</div>
            <div class="fs-4 fw-semibold">@Model.UniqueBooksLoaned</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="border rounded p-3">
            <div class="text-muted small">Active</div>
            <div class="fs-4 fw-semibold">@Model.ActiveLoans</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="border rounded p-3">
            <div class="text-muted small">Overdue</div>
            <div class="fs-4 fw-semibold">@Model.OverdueLoans</div>
        </div>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">No books were loaned for this report.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Book</th>
                <th>Author</th>
                <th>Member</th>
                <th>Loan Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (LoanReportItem item in Model.Items)
            {
                <tr>
                    <td>@item.BookTitle</td>
                    <td>@item.BookAuthor</td>
                    <td>
                        <div>@item.MemberName</div>
                        <div class="text-muted small">@item.MemberEmail</div>
                    </td>
                    <td>@item.LoanDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
                    <td>@(item.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td><span class="badge @BadgeClass(item.Status)">@item.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}
