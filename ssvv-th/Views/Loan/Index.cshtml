@model IEnumerable<ssvv_th.Models.Loan>
@{
    ViewData["Title"] = "Loans";

    string BadgeClass(string status) => status switch
    {
        "Returned" => "bg-secondary",
        "Overdue" => "bg-danger",
        _ => "bg-success"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Loans</h1>
    <a class="btn btn-primary" asp-action="Create">+ Borrow Book</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No loans yet. Borrow the first book.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Book</th>
                <th>Member</th>
                <th>Loan Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model)
            {
                <tr>
                    <td>@loan.Book?.Title</td>
                    <td>@loan.Member?.Name</td>
                    <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                    <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                    <td>@(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td><span class="badge @BadgeClass(loan.Status)">@loan.Status</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@loan.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@loan.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
